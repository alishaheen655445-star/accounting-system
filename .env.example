# ===========================================================================
#  Environment variables TEMPLATE — copy this file to `.env` and fill values.
#  The real `.env` is git-ignored and must NEVER be committed.
# ===========================================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- MySQL (XAMPP defaults: user=root, password empty, host=127.0.0.1) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=accounting_system

# --- JWT (use a long random secret in production) ---
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=1h
